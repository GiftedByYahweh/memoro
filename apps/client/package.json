{
  "name": "@memoro/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node -e \"const fs=require('fs');fs.copyFileSync(require.resolve('maplibre-gl/dist/maplibre-gl-worker.mjs'),'public/maplibre-gl-worker.mjs');fs.copyFileSync(require.resolve('maplibre-gl/dist/maplibre-gl-shared.mjs'),'public/maplibre-gl-shared.mjs');\"",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@memoro/shared": "*",
    "@tanstack/vue-query": "^5.102.8",
    "maplibre-gl": "^6.9.0",
    "reka-ui": "^2.10.4",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vue-tsc": "^2.2.4"
  }
}
